# Keep the lock out of the dist archive Packagist serves. `create-project`
# installs from a lock when it finds one, and a skeleton should resolve its
# constraints fresh instead — which is what Symfony and Laravel do. Shipping it
# once pinned v0.2.1 inside v0.3.0 and broke create-project outright.
#
# The lock stays tracked: it is what this checkout and CI install from, and
# bin/release.sh in the hydra monorepo refreshes it onto each release before
# tagging this repository, so it names the release it sits in.
/composer.lock      export-ignore

# Development against a sibling monorepo checkout. Meaningless in a new app,
# where ../hydra does not exist.
/composer.dev.json  export-ignore
/composer.dev.lock  export-ignore
