{
    "name": "hydrakit/app",
    "description": "Hydra PHP framework application skeleton",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "_comment": "LOCAL DEVELOPMENT ONLY. Use with: COMPOSER=composer.dev.json composer install. The glob resolves every hydrakit/* package from the hydra monorepo checkout via symlink, so edits are reflected immediately and a new package needs no edit here. Consumers use the plain composer.json, which resolves everything from Packagist.",
    "repositories": [
        {
            "type": "path",
            "url": "../hydra/packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hydrakit/core": "*",
        "hydrakit/cache": "^0.3",
        "hydrakit/http": "*",
        "hydrakit/validation": "*",
        "hydrakit/session": "*",
        "hydrakit/csrf": "*",
        "hydrakit/admin": "*",
        "hydrakit/auth": "*",
        "hydrakit/authorization": "*",
        "hydrakit/event": "*",
        "hydrakit/kernel": "*",
        "hydrakit/log": "*",
        "hydrakit/database": "*",
        "hydrakit/view": "*",
        "hydrakit/nyholm": "*",
        "hydrakit/console": "*",
        "hydrakit/php-di": "*",
        "nyholm/psr7": "^1.8",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public/"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
