# Dependencies
/vendor/

# Environment: never commit real secrets (keep a .env.example instead)
/.env

# Docker: MariaDB bind-mount data and any local compose overrides
/docker/db_data/
/docker-compose.local.yml

# PHPUnit
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Editors / OS
/.idea/
/.vscode/
.DS_Store
*.swp

# Note: composer.lock IS committed for applications (this is a "type": "project").
# It resolves hydrakit/* from Packagist. For local framework dev against your
# sibling checkouts, use: COMPOSER=composer.dev.json composer install
# That produces composer.dev.lock, which is machine-specific and NOT committed:
/composer.dev.lock

# php-cs-fixer
.php-cs-fixer.cache
