#!/usr/bin/env bash
# Run a command in the php container from the project dir, or open a shell with no args.
#   ./bin/exec                      # bash shell
#   ./bin/exec composer install     # run a command
#   ./bin/exec vendor/bin/phpunit   # run the tests
#
# The project is mounted at /var/www/html/app whatever its directory is called
# on the host (see docker-compose.yml), and commands run there so
# composer.json and vendor/ resolve.
set -euo pipefail

cd "$(dirname "$0")/.."

workdir="/var/www/html/app"

if [ $# -eq 0 ]; then
    exec docker compose exec -it -w "$workdir" php bash
else
    exec docker compose exec -it -w "$workdir" php "$@"
fi
