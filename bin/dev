#!/usr/bin/env bash
# Wrapper that runs docker compose with the dev override(s) applied.
# Use exactly like `docker compose`, e.g.:
#   ./bin/dev up -d --build
#   ./bin/dev down
#   ./bin/dev logs -f nginx
#
# Loads:
#   - docker-compose.yml          (base)
#   - docker-compose.dev.yml      (Traefik + proxy network)
#   - docker-compose.local.yml    (project-specific extras, if present)

set -euo pipefail

cd "$(dirname "$0")/.."

# php-fpm runs as www-data and the scheduler as root; both write the log here.
mkdir -p storage/logs && chmod 1777 storage/logs

# Uploads, written by php-fpm as www-data: the private disk and the public one.
mkdir -p storage/uploads storage/public && chmod 1777 storage/uploads storage/public

# The web server serves the public disk through this link. Relative, so it
# resolves on the host and in the containers alike; the same link
# `./hydra storage:link` makes, made here because the host may have no PHP.
[[ -e public/storage || -L public/storage ]] || ln -s ../storage/public public/storage

files=(-f docker-compose.yml -f docker-compose.dev.yml)
[[ -f docker-compose.local.yml ]] && files+=(-f docker-compose.local.yml)

exec docker compose "${files[@]}" "$@"
