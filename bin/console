#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use App\Bootstrap;
use App\Config\AppConfig;
use App\Console\Commands\MakeAbilityCommand;
use App\Console\Commands\MakeAdminCommand;
use App\Console\Commands\MakeControllerCommand;
use App\Console\Commands\MakeEntityCommand;
use App\Console\Commands\MakeListenerCommand;
use App\Console\Commands\MakeModuleCommand;
use App\Console\Commands\MakeRepositoryCommand;
use App\Console\Commands\MakeSourceCommand;
use App\Console\Commands\MakeSourceTestCommand;
use App\Console\Commands\MakeUserCommand;
use App\Console\Support\TableColumns;
use Hydra\Admin\Console\AdminCheckCommand;
use Hydra\Admin\Console\AdminRoutesCommand;
use Hydra\View\Contracts\ViewInterface;
use Hydra\Admin\ModuleRegistry;
use Hydra\Console\Commands\KeyGenerateCommand;
use Hydra\Console\Commands\MakeMigrationCommand;
use Hydra\Console\Commands\UpgradeCommand;
use Hydra\Database\Console\MigrateFreshCommand;
use Hydra\Database\Console\MigrateRunCommand;
use Hydra\Database\Console\MigrateStatusCommand;
use Hydra\Database\Contracts\ConnectionInterface;
use Hydra\Database\MigrationRunner;
use Hydra\Http\Console\DownCommand;
use Hydra\Http\Console\RouteCacheClearCommand;
use Hydra\Http\Console\RouteCacheCommand;
use Hydra\Http\Console\UpCommand;
use Hydra\Http\Maintenance;
use App\Providers\AppServiceProvider;
use App\Repositories\UserRepository;
use Hydra\Auth\Contracts\HasherInterface;
use Hydra\Http\RouteCache;
use Hydra\Queue\Console\QueueFailedCommand;
use Hydra\Queue\Console\QueueFlushCommand;
use Hydra\Queue\Console\QueueForgetCommand;
use Hydra\Queue\Console\QueueRetryCommand;
use Hydra\Queue\DatabaseQueue;
use Hydra\Scheduler\Console\ScheduleRunCommand;
use Hydra\Scheduler\Runner;
use Hydra\SymfonyConsole\ConsoleApplication;

// The console entrypoint
$app = Bootstrap::application(__DIR__ . '/..');
$app->boot();
$container = $app->container();

// Only commands that build nothing from the container are added eagerly. A
// service resolved here is resolved for every command, key:generate included,
// and the view reaches the signer, which will not build without APP_KEY: an
// eager admin:routes once made a fresh checkout unable to generate its key.
$application = new ConsoleApplication('Hydra');
$application->add(
    new KeyGenerateCommand(__DIR__ . '/../.env'),
    new MakeMigrationCommand(__DIR__ . '/../database/migrations'),
    new UpgradeCommand(dirname(__DIR__)),
    new MakeControllerCommand(__DIR__ . '/../src/Controllers'),
    new MakeAbilityCommand(__DIR__ . '/../src/Authorization'),
    new MakeListenerCommand(__DIR__ . '/../src/Listeners'),
);

// The table-shaped generators read the schema to fill in a column list, so
// they are loaded lazily beside the migrate:* commands rather than eagerly:
// a connection built for `list` is a connection a machine with no database
// running cannot build.
$tables = static fn (): TableColumns => new TableColumns($container->get(ConnectionInterface::class));
$source = static fn (): MakeSourceCommand => new MakeSourceCommand(__DIR__ . '/../src/Admin/Sources', $tables());
$module = static fn (): MakeModuleCommand => new MakeModuleCommand(__DIR__ . '/../src/Admin/Modules', $tables());
$sourceTest = static fn (): MakeSourceTestCommand => new MakeSourceTestCommand(__DIR__ . '/../tests/Unit', $tables());
$entity = static fn (): MakeEntityCommand => new MakeEntityCommand(__DIR__ . '/../src/Entities', $tables());
$repository = static fn (): MakeRepositoryCommand => new MakeRepositoryCommand(__DIR__ . '/../src/Repositories', $tables());

// The migrate:* commands need the database connection, so they are loaded lazily
// Keyed by class rather than by command name: the name is on each class's
// #[AsCommand], so writing it out again here would be a second copy free to
// disagree with the first.
$application->addLazy([
    RouteCacheCommand::class => static fn () => new RouteCacheCommand($container->get(RouteCache::class), AppServiceProvider::CONTROLLERS),
    RouteCacheClearCommand::class => static fn () => new RouteCacheClearCommand($container->get(RouteCache::class)),
    DownCommand::class => static fn () => new DownCommand($container->get(Maintenance::class)),
    UpCommand::class => static fn () => new UpCommand($container->get(Maintenance::class)),
    AdminRoutesCommand::class => static fn () => new AdminRoutesCommand($container->get(ModuleRegistry::class), $container->get(ViewInterface::class)),
    AdminCheckCommand::class => static fn () => new AdminCheckCommand($container->get(ModuleRegistry::class)),

    MigrateRunCommand::class => static fn () => new MigrateRunCommand($container->get(MigrationRunner::class)),
    MigrateFreshCommand::class => static fn () => new MigrateFreshCommand(
        $container->get(MigrationRunner::class),
        $container->get(AppConfig::class)->debug,
    ),
    MigrateStatusCommand::class => static fn () => new MigrateStatusCommand($container->get(MigrationRunner::class)),
    MakeUserCommand::class => static fn () => new MakeUserCommand(
        $container->get(UserRepository::class),
        $container->get(HasherInterface::class),
    ),

    MakeSourceCommand::class => $source,
    MakeModuleCommand::class => $module,
    MakeSourceTestCommand::class => $sourceTest,
    MakeEntityCommand::class => $entity,
    MakeRepositoryCommand::class => $repository,
    MakeAdminCommand::class => static fn () => new MakeAdminCommand($source(), $module(), $sourceTest(), $entity(), $repository()),
    ScheduleRunCommand::class => static fn () => new ScheduleRunCommand($container->get(Runner::class)),
    QueueFailedCommand::class => static fn () => new QueueFailedCommand($container->get(DatabaseQueue::class)),
    QueueRetryCommand::class => static fn () => new QueueRetryCommand($container->get(DatabaseQueue::class)),
    QueueForgetCommand::class => static fn () => new QueueForgetCommand($container->get(DatabaseQueue::class)),
    QueueFlushCommand::class => static fn () => new QueueFlushCommand($container->get(DatabaseQueue::class)),
]);

exit($application->run());
