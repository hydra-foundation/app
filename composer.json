{
    "name": "hydrakit/app",
    "description": "The application skeleton every Hydra project starts from.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hydrakit/core": "^0.27",
        "hydrakit/broadcast": "^0.27",
        "hydrakit/cache": "^0.27",
        "hydrakit/http": "^0.27",
        "hydrakit/validation": "^0.27",
        "hydrakit/queue": "^0.27",
        "hydrakit/scheduler": "^0.27",
        "hydrakit/seo": "^0.27",
        "hydrakit/session": "^0.27",
        "hydrakit/throttle": "^0.27",
        "hydrakit/csrf": "^0.27",
        "hydrakit/admin": "^0.27",
        "hydrakit/auth": "^0.27",
        "hydrakit/authorization": "^0.27",
        "hydrakit/event": "^0.27",
        "hydrakit/filesystem": "^0.27",
        "hydrakit/kernel": "^0.27",
        "hydrakit/log": "^0.27",
        "hydrakit/mail": "^0.27",
        "hydrakit/database": "^0.27",
        "hydrakit/view": "^0.27",
        "hydrakit/nyholm": "^0.27",
        "hydrakit/console": "^0.27",
        "hydrakit/php-di": "^0.27",
        "nyholm/psr7": "^1.8",
        "hydrakit/symfony-console": "^0.27"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public/",
        "stan": "phpstan analyse",
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "test": "phpunit",
        "qa": [
            "@stan",
            "@lint",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
