{
    "name": "hydrakit/app",
    "description": "Hydra PHP framework application skeleton",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hydrakit/core": "^0.2",
        "hydrakit/http": "^0.2",
        "hydrakit/validation": "^0.2",
        "hydrakit/session": "^0.2",
        "hydrakit/csrf": "^0.2",
        "hydrakit/auth": "^0.2",
        "hydrakit/authorization": "^0.2",
        "hydrakit/event": "^0.2",
        "hydrakit/kernel": "^0.2",
        "hydrakit/log": "^0.2",
        "hydrakit/database": "^0.2",
        "hydrakit/view": "^0.2",
        "hydrakit/nyholm": "^0.2",
        "hydrakit/console": "^0.2",
        "hydrakit/php-di": "^0.2",
        "nyholm/psr7": "^1.8",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
