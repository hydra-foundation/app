# APPLICATION
APP_NAME=Hydra
APP_URL=http://hydra.localhost
APP_DEBUG=true                    # Set to false in production
APP_TIMEZONE=UTC
APP_KEY=                          # Generate with: php bin/console key:generate
FORCE_HTTPS=false                 # Set to true in production to force https + HSTS
# Only trust the X-Forwarded-Proto header when TLS terminates at a proxy YOU
# control that always sets it (Traefik in the dev/prod stacks). Set to false
# when PHP serves clients directly — a spoofed header would bypass FORCE_HTTPS.
TRUST_FORWARDED_PROTO=true
# The peers allowed to speak for a client: comma-separated addresses or CIDR
# blocks. This is what decides whose X-Forwarded-For is believed, and every
# per-client budget (rate limits, the activity log) is keyed on the answer.
#
# Leave it EMPTY behind the bundled nginx: its real_ip module already resolves
# the header into REMOTE_ADDR for the ranges in docker/nginx/default.conf, so
# PHP reading it a second time would only add a way to spoof an address.
#
# Set it when PHP sits behind a proxy that forwards the header WITHOUT
# rewriting REMOTE_ADDR, and list that proxy — not the clients:
#   TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32
#
# Never set it to 0.0.0.0/0. That trusts every caller to name itself, which is
# the exact spoof the list exists to prevent.
TRUSTED_PROXIES=

# CONTENT SECURITY POLICY
# The policy is declared in AppServiceProvider; these only decide whether and
# how it is sent. Turn CSP_ENABLED off only to rule the policy out while
# debugging something else.
CSP_ENABLED=true
# Report violations instead of blocking them. Use this to roll a changed policy
# out over content that already exists — a directive that is too tight shows up
# in the reports rather than in a broken page — then set it back to false.
CSP_REPORT_ONLY=false
# Where the browser POSTs violation reports. Empty sends no report-uri at all.
CSP_REPORT_URI=

# SESSION
# The session cookie. SESSION_SECURE is the one that matters in production:
# without it the cookie travels over plain http and is readable in transit.
# Turn it on wherever FORCE_HTTPS is on — a Secure cookie on an http-only dev
# stack simply never comes back, which looks like a broken login.
SESSION_NAME=hydra_session
SESSION_LIFETIME=0                # 0 = expires when the browser closes
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=false              # Set to true in production (https only)
SESSION_HTTP_ONLY=true            # Keep true: JavaScript must not read this
SESSION_SAME_SITE=Lax             # Lax | Strict | None (None demands Secure)

# AUTH
# bcrypt work factor used by Hydra\Auth\NativeHasher. Higher is slower and more
# resistant to brute force; raise it as high as your hardware tolerates in
# production. Tests and CI use a low cost so hashing stays fast. Valid range 4-31.
AUTH_HASH_COST=12

# ROUTING
# Compile controller #[Route] attributes to bootstrap/cache/routes.php and load
# them from there instead of reflecting on every request. A production-only
# optimisation: leave it false in development so route edits take effect at
# once. When true, build the cache with `php bin/console route:cache` (rebuild
# with the same command, drop it with route:cache:clear). The web path only
# reads the cache — `route:cache` is the sole writer.
ROUTE_CACHE=false

# LOGGING
# php://stderr surfaces logs via `docker logs`. Use an absolute,
# writable file path for a file sink. An unwritable path falls back to stderr.
LOG_PATH=php://stderr

# DOCKER
# Host port the dev stack publishes nginx on (http://localhost:<APP_PORT>).
APP_PORT=8080
# The reverse proxy that fronts the PRODUCTION stack, as one address or CIDR
# block on the Docker network. docker-compose.prod.yml refuses to start without
# it, because nginx would otherwise have no way to recover the client address.
# Never widen this to the bridge subnet (172.18.0.0/16): a published port makes
# every external caller arrive from the bridge gateway, so that range would let
# any client on the internet choose its own address.
NGINX_TRUSTED_PROXY=

# Hostname for the optional Traefik proxy (docker-compose.local.yml):
# http://<DEV_HOSTNAME>.localhost. Subdomains route too (*.localhost).
DEV_HOSTNAME=hydra

# DATABASE
DB_DRIVER=mariadb
DB_NAME=hydra
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=db                        # "db" inside Docker, "localhost" on the host
DB_PORT=3306
DB_CHARSET=utf8mb4

# CACHE / REDIS
# Where shared counters live. Keep this on redis anywhere more than one PHP
# process serves traffic: the array store is per-process, so behind php-fpm it
# would give each worker its own counters and multiply every limit by the pool
# size. It exists for tests and single-process tooling only.
CACHE_STORE=redis                 # redis | array
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                   # Set a password in production
REDIS_DATABASE=0
# Namespaces every key. Give each application its own prefix when they share a
# Redis instance, or they count each other's requests.
REDIS_PREFIX=hydra:
REDIS_TIMEOUT=1.0                 # Connect timeout in seconds; must be > 0
